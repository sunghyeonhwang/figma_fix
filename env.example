# Supabase Auth
# Vercel Project Settings -> Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=griff.co.kr

# Optional fallback Figma token for internal deployments.
# Users can also enter their own token in the app settings.
FIGMA_ACCESS_TOKEN=figd_your_access_token_here
